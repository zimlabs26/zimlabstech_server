# Copia este archivo a .env para desarrollo local. En Render estas variables se cargan en el panel (Environment).

# Puerto. Render lo define solo (no hace falta ponerlo alla).
PORT=3000

# Direccion de la WEB (el origen desde el que el navegador llama a la API). Debe coincidir EXACTO, sin barra final.
#   desarrollo:  http://localhost:7777
#   produccion:  https://tu-sitio.vercel.app   (o tu dominio propio)
WEB_ORIGIN=http://localhost:7777

# Produccion: NODE_ENV=production activa cookies solo-HTTPS (Secure).
# NODE_ENV=production

# Ruta del archivo de la base de datos SQLite. Por defecto: ./data/app.db
# En Render GRATIS no hace falta definirla (usa ./data/app.db y Litestream la respalda).
# Con un disco persistente de pago: DB_PATH=/var/data/app.db

# Primera cuenta sin consola (hosting sin Shell): se crea el super admin SOLO si la base esta vacia.
# Borra BOOTSTRAP_SUPER_PASSWORD despues del primer ingreso.
# BOOTSTRAP_SUPER_EMAIL=tu@correo.com
# BOOTSTRAP_SUPER_PASSWORD=una-clave-de-12-o-mas-caracteres

# Respaldo de la base con Litestream (solo produccion, Render gratis). Backblaze B2 u otro almacenamiento S3.
# LITESTREAM_BUCKET=nombre-del-bucket
# LITESTREAM_ENDPOINT=https://s3.us-west-004.backblazeb2.com
# LITESTREAM_REGION=us-west-004
# LITESTREAM_ACCESS_KEY_ID=
# LITESTREAM_SECRET_ACCESS_KEY=

# Mercado Pago (debito automatico del mantenimiento). Access Token y clave secreta del webhook, desde
# mercadopago.com.ar/developers > tu aplicacion. Nunca los subas al repositorio.
# MP_ACCESS_TOKEN=
# MP_WEBHOOK_SECRET=
# Direccion publica de la web: adonde vuelve el cliente despues de activar el debito.
# PUBLIC_URL=https://tu-sitio.vercel.app

# Cuantos proxies hay delante del servidor (por defecto 1 en produccion y 0 en desarrollo).
# Si la web de Vercel reenvia /api hacia Render, son 2.
# TRUST_PROXY=2

# Correo saliente (Gmail con contrasena de aplicacion de 16 letras). Opcional: sin esto no se envia el aviso de alta.
# MAIL_USER=tu@gmail.com
# MAIL_PASS=
# MAIL_FROM_NAME=Zim Labs
